DEBUG=TRUE
SERVER_NAME=*
LOCAL_DB=TRUE

# Team generation API (repository "algorithms"), see docs/team_generation.md
# URL of POST /api/generate/teams/ (default: http://localhost:8001/api/generate/teams/)
TEAM_GENERATION_API_URL=http://localhost:8001/api/generate/teams/
# Plain API key. Its hash must be listed in API_AUTH_ALLOWED_KEYS of the algorithms API.
TEAM_GENERATION_API_KEY=
# Seconds to wait for the API (default: 90)
TEAM_GENERATION_API_TIMEOUT=90

# LTI Config
LTI_CONF_FOLDER=lti/config
LTI_CONF_FILE_NAME=lti_config_settings.json

# Canvas OAuth2 Config
CANVAS_BASE_URL=http://canvas.docker
CANVAS_OAUTH_CLIENT_ID=client_id
CANVAS_OAUTH_CLIENT_SECRET=client_secret

# Configuring frontend
FRONTEND_BASE_URL=http://localhost:3000